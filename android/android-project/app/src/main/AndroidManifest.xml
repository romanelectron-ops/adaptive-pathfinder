<?xml version="1.0" encoding="utf-8"?>
<!--
    Атрибут package здесь БОЛЬШЕ НЕ УКАЗЫВАЕТСЯ: начиная с AGP 8 он запрещён и сборка
    падает с ошибкой. Имя пакета задаётся через namespace в app/build.gradle.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Перечисление установленных приложений — для экрана «Приложения вне VPN»
        (VpnService.Builder.addDisallowedApplication). Начиная с Android 11 приложение по
        умолчанию видит лишь малую часть чужих пакетов.

        Найдено консилиумом 2026-08-24: раньше здесь стоял QUERY_ALL_PACKAGES — это
        restricted permission в Google Play, одобряется только для узкого списка назначений
        (антивирусы, файловые менеджеры, лаунчеры), «показать список для split-tunneling» в
        него не входит — риск отказа в публикации/снятия обновления. tools:ignore глушит
        только lint-предупреждение в IDE, на политику Play он не влияет.

        При этом широкий доступ и не нужен: showDisallowedAppsDialog (MainActivity.kt) сам
        фильтрует результат по pm.getLaunchIntentForPackage(...) != null — то есть реально
        нужны только пакеты с LAUNCHER-активностью. Эту видимость даёт декларация intent-фильтра
        ниже, БЕЗ restricted permission: <queries> открывает видимость по паттерну intent'а, а
        не по перечню конкретных пакетов, так что прежнее обоснование «список у каждого свой,
        заранее не перечислить» здесь ни при чём — перечислять и не требовалось.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Сетевые разрешения -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- UPnP-обнаружение роутера (роль «Выход», Reachability.Detect, 2026-08-28): без
         удержания WifiManager.MulticastLock Android глушит входящий SSDP-мультикаст на
         Wi-Fi-радио ради экономии батареи — этому разрешению для лока и подчиняется. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- VPN разрешение (критично) -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />

    <!-- Foreground service (для Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- LongOpForegroundService (2026-09-22): partial wake lock на время скана/пробы/харвеста,
         чтобы CPU не уходил в сон при погашенном экране и операция не обрывалась на середине. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Автозапуск при загрузке устройства -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Уведомления (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Вибрация для уведомлений -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Запись файлов (для логов в DataDir) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ApfApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.APF"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Главная Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- APF VPN Service — ключевой компонент -->
        <service
            android:name=".APFVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- LongOpForegroundService (2026-09-22): держит скан/пробу/харвест живыми при
             свёрнутом приложении/погашенном экране. Не связан с VPN — APFVpnService выше
             отвечает за туннель, этот сервис только за три длинные операции с узлами. -->
        <service
            android:name=".LongOpForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Автозапуск при загрузке устройства -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Провайдер для FileProvider (если нужно шарить файлы конфигов) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
