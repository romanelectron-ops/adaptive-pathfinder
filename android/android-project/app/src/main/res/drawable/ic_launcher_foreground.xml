<?xml version="1.0" encoding="utf-8"?>
<!--
    Передний план адаптивной иконки: щит (защита) со стрелкой обхода (поиск пути).

    Векторный, а не PNG, намеренно: minSdk 26 поддерживает адаптивные иконки,
    поэтому растровые mipmap-каталоги не нужны вовсе, и в репозитории не появляется
    ни одного двоичного файла.

    Холст 108x108 dp — требование адаптивной иконки; безопасная зона — центральные 72 dp,
    всё за её пределами может быть обрезано маской устройства.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Щит -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M54,26 L74,34 L74,54 C74,66 65,76 54,82 C43,76 34,66 34,54 L34,34 Z" />

    <!-- Внутреннее поле щита -->
    <path
        android:fillColor="#0E2A47"
        android:pathData="M54,33 L68,38.6 L68,54 C68,63 61.5,70.8 54,75.6 C46.5,70.8 40,63 40,54 L40,38.6 Z" />

    <!-- Стрелка обхода: вниз, вбок, вверх -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M47,44 L47,56 L57,56 L57,52 L65,58 L57,64 L57,60 L43,60 L43,44 Z" />
</vector>
