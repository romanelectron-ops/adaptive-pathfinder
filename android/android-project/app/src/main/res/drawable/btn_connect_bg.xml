<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон главной кнопки. Скругление задаётся здесь, а не атрибутом android:cornerRadius:
    такого атрибута у обычного Button не существует (он есть только у MaterialButton,
    и то под пространством имён app:). Разметка использовала android:cornerRadius,
    и сборка падала: «AAPT: attribute android:cornerRadius not found».
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#30363d" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2563d4" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4f8ef7" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
